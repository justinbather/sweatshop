# Copy to .env for docker compose. Env vars always win over dashboard-entered keys.
LINEAR_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
POSTIZ_API_KEY=
DISCORD_WEBHOOK_URL=
LINEAR_TEAM=CON
TZ=America/Toronto
# password for the hosted dashboard (unset = open — only safe locally)
DASHBOARD_PASSWORD=

# --- hosted mode (Supabase) — leave blank to run fully local -------------------
# Postgres: Supabase → Project Settings → Database → connection string (session pooler)
DATABASE_URL=
# Storage (S3-compatible): Supabase → Project Settings → Storage → S3 connection.
# Setting S3_ENDPOINT switches images from the ./data volume to the bucket.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=sweatshop
